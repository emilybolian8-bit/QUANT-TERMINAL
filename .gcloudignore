# Files excluded from `gcloud builds submit` / `gcloud app deploy` uploads.
# Mirrors .dockerignore so local and gcloud uploads behave the same way.

node_modules
dist
dist-ssr
*.local

# Secrets: GEMINI_API_KEY is supplied at runtime, never uploaded or baked in.
.env
.env.*
!.env.example

# Local deploy credentials. git.txt holds the fine-grained GitHub PAT used to
# push; it must never reach Cloud Build, the image, or the repository.
git.txt
*.key
*token*.txt

# Local run output, never part of a build context.
dev.err
*.err
ERROR.txt

# Reference design doc kept locally; not app code, so it is not uploaded.
liquidation_heatmap.html

# Runtime data written at boot: the liquidation tape (hourly JSONL), the
# CoinGecko id-map (coingecko.json), and the automated scanner's config and
# kline cache (auto-scanner/config.json, auto-scanner/klines.json). Never
# uploaded; each instance rebuilds or loads its own from the /data mount.
data

.git
.gitignore
.github
.vscode
.idea
*.swp

*.log
npm-debug.log*
.DS_Store
Thumbs.db

Dockerfile
.dockerignore
.gcloudignore

assets/.aistudio
