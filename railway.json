{
  "service": "crypto-quant-terminal",
  "project": "your-railway-project",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "env": {
    "NODE_ENV": "production",
    "PORT": "8080",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false",
    "LIQ_DATA_DIR": "/data/liq",
    "COINGECKO_DATA_FILE": "/data/coingecko.json",
    "AUTO_SCAN_DIR": "/data/auto-scanner",
    "API_HOST": "0.0.0.0",
    "API_PORT": "8000",
    "API_SECRET_KEY": "change-me-in-production",
    "COLLECTOR_ENABLED_VENUES": "binance,bybit,okx,hyperliquid",
    "COLLECTOR_OI_POLL_INTERVAL": "15",
    "COLLECTOR_KLINE_POLL_INTERVAL": "60",
    "COLLECTOR_BACKFILL_HOURS": "36",
    "ENGINE_COMPUTE_INTERVAL": "5",
    "ENGINE_ALERT_EVAL_INTERVAL": "5",
    "BINANCE_RATE_LIMIT": "1200",
    "BYBIT_RATE_LIMIT": "120",
    "OKX_RATE_LIMIT": "120",
    "HYPERLIQUID_RATE_LIMIT": "120",
    "ALERT_DEFAULT_COOLDOWN_S": "900",
    "ALERT_MIN_PRIOR_VOL_5M": "50000",
    "ALERT_MIN_24H_VOL": "1000000",
    "LOG_LEVEL": "INFO"
  },
  "volumes": ["/data"],
  "port": 8080,
  "healthcheck": {
    "path": "/healthz",
    "interval": "30s",
    "timeout": "5s",
    "retries": 3
  },
  "autoDeploy": true,
  "minInstances": 1,
  "maxInstances": 1
}