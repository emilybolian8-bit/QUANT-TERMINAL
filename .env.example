# FlowDesk Environment Variables
# Copy to .env and fill in values
# For Railway VPS: set these in the Railway dashboard or .env file

# Database
DATABASE_URL=postgresql+asyncpg://flowdesk:flowdesk@postgres:5432/flowdesk
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=flowdesk
POSTGRES_DB=flowdesk

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# Collector
COLLECTOR_ENABLED_VENUES=binance,bybit,okx,hyperliquid
COLLECTOR_OI_POLL_INTERVAL=15
COLLECTOR_KLINE_POLL_INTERVAL=60
COLLECTOR_BACKFILL_HOURS=36

# Engine
ENGINE_COMPUTE_INTERVAL=5
ENGINE_ALERT_EVAL_INTERVAL=5

# Rate limits
BINANCE_RATE_LIMIT=1200
BYBIT_RATE_LIMIT=120
OKX_RATE_LIMIT=120
HYPERLIQUID_RATE_LIMIT=120

# Alerts
ALERT_DEFAULT_COOLDOWN_S=900
ALERT_MIN_PRIOR_VOL_5M=50000
ALERT_MIN_24H_VOL=1000000

# Logging
LOG_LEVEL=INFO

# Gemini AI (optional - for /api/report endpoint)
# Set GEMINI_API_KEY in Railway dashboard secrets or .env for AI memo generation
GEMINI_API_KEY=""

# App URL
# The URL where this app is hosted (set by Railway automatically)
APP_URL=""

# PORT: TCP port the server binds on 0.0.0.0.
# Railway injects this automatically (8080); only set it for local/container runs.
# Defaults to 3000 when unset.
# PORT=3000

# NODE_ENV: "production" serves the prebuilt dist/ bundle and skips the Vite
# dev middleware. Set by the Dockerfile; do not set to "production" locally or
# the dev server will have no assets to serve.
# NODE_ENV=production