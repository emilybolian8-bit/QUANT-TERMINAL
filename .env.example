# FlowDesk Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://flowdesk:flowdesk@postgres:5432/flowdesk
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=flowdesk
POSTGRES_DB=flowdesk

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# Collector
COLLECTOR_ENABLED_VENUES=binance,bybit,okx,hyperliquid
COLLECTOR_OI_POLL_INTERVAL=15
COLLECTOR_KLINE_POLL_INTERVAL=60
COLLECTOR_BACKFILL_HOURS=36

# Engine
ENGINE_COMPUTE_INTERVAL=5
ENGINE_ALERT_EVAL_INTERVAL=5

# Rate limits
BINANCE_RATE_LIMIT=1200
BYBIT_RATE_LIMIT=120
OKX_RATE_LIMIT=120
HYPERLIQUID_RATE_LIMIT=120

# Alerts
ALERT_DEFAULT_COOLDOWN_S=900
ALERT_MIN_PRIOR_VOL_5M=50000
ALERT_MIN_24H_VOL=1000000

# Logging
LOG_LEVEL=INFO
=======
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# For Cloud Run, store it in Secret Manager and attach it at deploy time:
#   gcloud run services update <SERVICE> --set-secrets=GEMINI_API_KEY=GEMINI_API_KEY:latest
# The app runs without it; /api/report falls back to a local heuristic memo.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: TCP port the server binds on 0.0.0.0.
# Cloud Run injects this automatically (8080); only set it for local/container
# runs. Defaults to 3000 when unset.
# PORT=3000

# NODE_ENV: "production" serves the prebuilt dist/ bundle and skips the Vite
# dev middleware. Set by the Dockerfile; do not set to "production" locally or
# the dev server will have no assets to serve.
# NODE_ENV=production
